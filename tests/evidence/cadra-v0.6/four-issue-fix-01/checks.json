{
  "all-tests": {
    "command": [
      "python3",
      "-B",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-p",
      "test_*.py",
      "-v"
    ],
    "exit_code": 0
  },
  "static": {
    "command": [
      "python3",
      "-B",
      "tests/cadra-static-checks.py"
    ],
    "exit_code": 0
  },
  "diff-check": {
    "command": [
      "git",
      "diff",
      "--check",
      "--",
      "cadra",
      "tests/cadra_v06_model.py",
      "tests/test_cadra.py",
      "tests/cadra-scenarios.md"
    ],
    "exit_code": 0
  }
}
