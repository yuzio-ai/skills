--- /dev/null
+++ b/test_greeting.py
@@ -0,0 +1,25 @@
+import unittest
+from unittest.mock import patch
+
+from greeting import greet
+
+
+class GreetingTests(unittest.TestCase):
+    def test_nonempty_names_are_preserved(self):
+        for name in ("Ada", "  Ada  ", " ", "\t\n", "你好🌍", "e\u0301"):
+            with self.subTest(name=name):
+                self.assertEqual(greet(name), f"Hello, {name}!")
+
+    def test_empty_name_uses_world(self):
+        self.assertEqual(greet(""), "Hello, world!")
+
+    def test_prefix_is_obtained_on_each_call(self):
+        with patch("greeting.greeting_prefix", side_effect=["Hi", "Welcome"]) as prefix:
+            self.assertEqual(greet("Ada"), "Hi, Ada!")
+            self.assertEqual(greet(""), "Welcome, world!")
+        self.assertEqual(prefix.call_count, 2)
+        prefix.assert_called_with()
+
+
+if __name__ == "__main__":
+    unittest.main()
